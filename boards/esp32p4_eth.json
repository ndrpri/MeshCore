{
    "build": {
      "arduino": {
        "ldscript": "esp32p4_out.ld",
        "partitions": "default.csv",
        "memory_type": "qio_qspi"
      },
      "core": "esp32",
      "extra_flags": [
        "-DARDUINO_USB_MODE=1",
        "-DARDUINO_USB_CDC_ON_BOOT=1",
        "-DARDUINO_RUNNING_CORE=1",
        "-DARDUINO_EVENT_RUNNING_CORE=1"
      ],
      "f_cpu": "360000000L",
      "f_flash": "80000000L",
      "flash_mode": "qio",
      "mcu": "esp32p4",
      "variant": "esp32p4"
    },
    "connectivity": [
      "ethernet"
    ],
    "debug": {
      "default_tool": "esp-builtin",
      "onboard_tools": [
        "esp-builtin"
      ],
      "openocd_target": "esp32p4.cfg"
    },
    "frameworks": [
      "arduino",
      "espidf"
    ],
    "name": "Waveshare ESP32-P4-ETH (16MB Flash 32MB PSRAM)",
    "upload": {
      "flash_size": "16MB",
      "maximum_ram_size": 33554432,
      "maximum_size": 16777216,
      "require_upload_port": true,
      "speed": 460800
    },
    "url": "https://www.waveshare.com/esp32-p4-eth.htm",
    "vendor": "Waveshare"
  }
